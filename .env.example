# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Required for email verification / password reset to actually send mail.
# Without it, emails are logged instead of sent (fine for local dev).
RESEND_API_KEY=
# Absolute base URL used to build links inside emails (verify/reset).
# Falls back to the live request's own host if unset — set this explicitly
# in production so links are always correct behind a proxy/CDN.
APP_BASE_URL=https://your-app.onrender.com

# Optional
FINNHUB_API_KEY=
PORT=5000
LOG_LEVEL=WARNING
FLASK_ENV=production
