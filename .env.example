# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Required for email verification / password reset to actually send mail.
# Without them, emails are logged instead of sent (fine for local dev).
# Brevo (free, no domain needed): sign up at brevo.com, verify one sender
# email address you own under Settings > Senders, then use that address
# as MAIL_FROM below and the API key from Settings > SMTP & API.
BREVO_API_KEY=
MAIL_FROM=you@example.com
# Absolute base URL used to build links inside emails (verify/reset).
# Falls back to the live request's own host if unset — set this explicitly
# in production so links are always correct behind a proxy/CDN.
APP_BASE_URL=https://your-app.onrender.com

# Optional
FINNHUB_API_KEY=
PORT=5000
LOG_LEVEL=WARNING
FLASK_ENV=production
